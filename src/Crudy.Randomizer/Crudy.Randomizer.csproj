<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Crudy.Randomizer</PackageId>
        <Version>1.1.0</Version>
        <Authors>Onur Safran</Authors>
        <Copyright>Copyright (c) 2022-2026 Onur Safran</Copyright>
        <Description>Easy to use weighted randomizer for C#. Works as an item pool (weights are chances) or as marbles in a sack (weights are amounts), with exclusions, unique draws, seeding and combining.</Description>
        <PackageTags>random;randomizer;weighted;weighted-random;loot;loot-table;pool;sack;gamedev</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/OnurSafran/Crudy.Randomizer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/OnurSafran/Crudy.Randomizer</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>https://github.com/OnurSafran/Crudy.Randomizer/releases</PackageReleaseNotes>

        <!-- Debugging into the package: symbols on nuget.org, sources from GitHub (Source Link is built into the SDK) -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Checks the package for API differences between target frameworks, and against the last release -->
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
    </PropertyGroup>

    <!-- Reproducible builds in CI -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
